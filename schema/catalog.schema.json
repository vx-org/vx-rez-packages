{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vx-org/vx-rez-packages/schema/catalog-v1.json",
  "title": "vx immutable runtime release catalog",
  "description": "Exact runtime releases from independent repositories. The catalog validator additionally enforces uniqueness of (tool, version).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": { "const": 1 },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "version", "index_url", "index_sha256"],
        "properties": {
          "tool": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          "version": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          "index_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "index_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
