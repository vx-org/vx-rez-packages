{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vx-org/vx-rez-packages/schema/release-index-v1.json",
  "title": "vx Rez bundle release index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "release_tag",
    "bundles",
    "unsupported_targets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "release_tag": { "type": "string", "minLength": 1 },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "version",
          "platform",
          "arch",
          "triple",
          "asset_name",
          "download_url",
          "sha256",
          "bundle_schema_version",
          "package_root"
        ],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["windows", "linux", "osx"] },
          "arch": { "enum": ["x86_64", "arm_64"] },
          "triple": { "type": "string", "minLength": 1 },
          "asset_name": { "type": "string", "pattern": "^[^/]+\\.rez\\.tar\\.zst$" },
          "download_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bundle_schema_version": { "const": 1 },
          "package_root": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
        }
      }
    },
    "unsupported_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["triple", "status", "reason"],
        "properties": {
          "triple": { "type": "string", "minLength": 1 },
          "status": { "const": "unsupported" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
